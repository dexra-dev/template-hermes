# Settings for the dexra-trader MCP server. They are read from the environment only.
# Under Hermes, put the secrets in ~/.hermes/.env and the rest in the server's env block
# (see hermes/config.example.yaml). For scripts/smoke.py: uv run --env-file .env python scripts/smoke.py

# Dexra API key (dxr_...). Without it paid checks answer 402, so every buy is blocked. Get one at
# https://dexra.dev/app/keys?utm_source=github&utm_medium=referral&utm_campaign=templates&utm_content=template-hermes
DEXRA_API_KEY=
# Point at a local Dexra API for testing, e.g. http://127.0.0.1:3000.
DEXRA_BASE_URL=https://api.dexra.dev

# Jupiter API key, sent as x-api-key. Needed for live trading; in a dry run it adds a quote.
JUPITER_API_KEY=
# Base58 64-byte secret key. Only for live trading. Use a dedicated wallet that holds little SOL.
SOLANA_PRIVATE_KEY=

# Trades are sent only when DRY_RUN=false AND SOLANA_PRIVATE_KEY AND JUPITER_API_KEY are all set.
DRY_RUN=true
# Hard cap per buy, in SOL. A larger buy is refused, not reduced.
MAX_TRADE_SOL=0.05
# Slippage sent to Jupiter, whole number from 0 to 1000.
SLIPPAGE_BPS=100
# When true, a caution verdict passes the guard. avoid and unknown always block.
ALLOW_CAUTION=false
